# Backend/Compose: optional copy to root .env. Defaults are LOCAL DEVELOPMENT ONLY.
APP_NAME="Action Quiz API"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# 55432 avoids collision with other local PostgreSQL installations.
POSTGRES_DB=action_quiz
POSTGRES_USER=action_quiz
POSTGRES_PASSWORD=action_quiz_dev_only
POSTGRES_PORT=55432
# Local backend uses localhost; Compose API uses postgres:5432 (configured in Compose).
DATABASE_URL=postgresql+asyncpg://action_quiz:action_quiz_dev_only@localhost:55432/action_quiz
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend: optional copy ONLY these public fields to apps/web/.env.local.
# Provider settings below apply to the mock playground.
# /play always uses real camera/MediaPipe + mock quiz data; no env file is needed.
NEXT_PUBLIC_POSE_PROVIDER=mock
NEXT_PUBLIC_QUIZ_PROVIDER=mock
NEXT_PUBLIC_API_URL=http://localhost:8000
# Missing API URL disables the health indicator request; mock mode still works.
# Playground is always disabled in production builds.
# Production requires explicit non-default DATABASE_URL and CORS_ORIGINS.

